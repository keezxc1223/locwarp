{
  "name": "locwarp",
  "version": "0.2.211",
  "description": "iOS Virtual Location Simulator",
  "author": "keezxc1223",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron": "electron .",
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "s2-geometry": "^1.2.10",
    "supercluster": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.locwarp.app",
    "productName": "LocWarp",
    "directories": {
      "output": "release"
    },
    "afterPack": "build/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "keezxc1223",
        "repo": "locwarp"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist-py/locwarp-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../extensions/pipi-cookie-sync",
        "to": "extensions/pipi-cookie-sync",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "LocWarp-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocWarp",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh"
    },
    "electronLanguages": [
      "zh-TW",
      "zh-CN",
      "en-US"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
